// 由 CMake 从 app.rc.in 生成，不要直接编辑构建目录里的 app.rc
// 版本号来自 CMakeLists.txt 的 project(... VERSION ...)

101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/icons/app.ico"

1 VERSIONINFO
 FILEVERSION @FS_VERSION_COMMA@
 PRODUCTVERSION @FS_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hosts-es"
            VALUE "FileDescription", "Format Studio"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "formatstudio"
            VALUE "LegalCopyright", "Copyright (C) 2026 hosts-es"
            VALUE "OriginalFilename", "formatstudio.exe"
            VALUE "ProductName", "Format Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
